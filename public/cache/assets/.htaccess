# Asset Cache Configuration
# Aggressive caching for optimized assets

<IfModule mod_expires.c>
    ExpiresActive On
    
    # CSS files - 1 year (immutable)
    ExpiresByType text/css "access plus 1 year"
    
    # JavaScript files - 1 year (immutable)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images - 30 days
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    
    # Fonts - 1 year (immutable)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Add immutable directive for versioned assets
    <FilesMatch "\.(css|js|woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Add shorter cache for images
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Gzip compression
    <FilesMatch "\.(css|js|html|xml|txt|json)$">
        Header set Content-Encoding gzip
    </FilesMatch>
    
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    SetOutputFilter DEFLATE
    SetEnvIfNoCase Request_URI \
        \.(?:gif|jpe?g|png|webp)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \
        \.(?:exe|t?gz|zip|bz2|sit|rar)$ no-gzip dont-vary
</IfModule>

# Prevent access to source maps in production
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>

# Enable CORS for fonts
<FilesMatch "\.(woff|woff2|ttf|otf)$">
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>